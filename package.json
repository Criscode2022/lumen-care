{
  "name": "lumen-care",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "overrides": {
    "nf3": "0.3.17",
    "typescript": "~5.8.3"
  },
  "scripts": {
    "dev": "node scripts/dev-stack.mjs",
    "dev:vite": "node scripts/with-app-env.mjs vite dev --host 0.0.0.0 --port 8080",
    "build": "npm run build:web && npm run db:migrate",
    "build:web": "ng build web --configuration production",
    "build:api": "tsc -p apps/api/tsconfig.json --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "build:dev": "ng build web --configuration development",
    "preview": "HOST=127.0.0.1 PORT=8081 npx tsx --tsconfig apps/api/tsconfig.json apps/api/src/main.ts",
    "preview:restart": "node scripts/preview.mjs restart",
    "preview:stop": "node scripts/preview.mjs stop",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "check:auth": "node scripts/check-auth-invariant.mjs",
    "test": "node --test 'scripts/**/*.test.mjs' && node --experimental-strip-types --test src/lib/app-data/app-data.test.ts src/lib/auth/gate-identity.test.ts && npm run test:api",
    "test:api": "npx tsx --tsconfig apps/api/tsconfig.json --test apps/api/src/lumen.service.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "start": "npx tsx --tsconfig apps/api/tsconfig.json apps/api/src/main.ts"
  },
  "dependencies": {
    "@angular/animations": "^19.2.25",
    "@angular/build": "^19.2.27",
